# Copy this file to services/voice-api/.env and fill in the values for this machine.

# Optional path to an existing Qwen3-TTS model snapshot. Leave unset to use
# Studio's on-demand model onboarding and the development default location.
# MODEL_PATH=D:\models\qwen3-tts

# Higher quality uses its own directory and never replaces MODEL_PATH.
# HIGHER_MODEL_PATH=D:\models\qwen3-tts-higher

# Needed only for the Vite dev server on :5173. Packaged builds use one local
# origin, so there is nothing cross-origin to allow.
#
# Both spellings of the dev server: localhost:5173 and 127.0.0.1:5173 are the
# same socket but *different origins* to CORS, so listing only one makes the
# app work at one URL and fail every API call at the other.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for permanent bulk deletion from Settings. Keep the value private.
HOMEGROWN_ADMIN_PASSWORD=
