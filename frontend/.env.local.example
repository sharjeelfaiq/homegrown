# Copy to frontend/.env.local for local development (two terminals: uvicorn on
# 8000, `npm run dev` on 5173). vite.config.ts deliberately has no dev proxy, so
# the frontend has to be told where the backend is.
#
# ⚠️ This value is BAKED INTO THE BUNDLE at build time. It must be unset when
# building for LAN or the desktop installer, or every LAN client calls its own
# loopback instead of the server. build.sh handles that automatically: it
# stashes .env.local before the frontend build and restores it afterwards.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Only set in the Vercel project, never locally. Gates the RunPod wake path in
# frontend/api/wake.ts; unset means the app talks to the backend directly.
# VITE_USE_RUNPOD_WAKE=1
