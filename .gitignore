# Python
__pycache__/
*.pyc
services/voice-api/venv/

# Node
node_modules/
dist/

# Personal/generated data -- uploaded voice clips, generated audio, presets & history
services/voice-api/storage/

# Stray test artifacts
services/voice-api/gen_resp.json
services/voice-api/uvicorn.log

# Env / secrets
.env
*.env.local

# OS
.DS_Store
Thumbs.db
.vercel

# Python venv / pip cache
.venv/
.tmp_pip/

# PyInstaller build output
services/voice-api/build/
desktop/launcher/build/

# Packaged installer output
installer.zip

# /brag video output is tracked; Hyperframes check/snapshot artifacts and preview caches are ignored
brag-output*/composition/.hyperframes/
# /brag working files and media that must not be published: raw screen
# recordings (personal on-screen data), local tool environments, and generated
# audio (cloned voices, TTS narration). The rendered brag.mp4 stays tracked.
brag-output*/work/
brag-output*/composition/assets/footage/
brag-output*/composition/assets/audio/
brag-output*/composition/assets/vo/
# Hyperframes preview caches
brag-output*/composition/.waveform-cache/
brag-output*/composition/.thumbnails/

# setup.sh working dirs -- kept on the repo's drive so multi-GB pip wheels and
# model weights don't fill the system drive (see setup.sh header)
.pip-cache/
.tmp/
models/
.env*
!*.env.example
!*.env.local.example

# Regenerable analysis output; retain intentional reports
**/graphify-out/*
!**/graphify-out/*.md

# Temporary test output and backup environments
.test-tmp/
.venv.backup*/
.venv-py*/
